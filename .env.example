# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is git-ignored on purpose — never commit your real key.

# Get one at https://console.anthropic.com/ (Settings -> API Keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model answers as your clone.
CLAUDE_MODEL=claude-sonnet-5

# Local port for the web app.
PORT=3000

# Secret you type into /admin.html so only you can intercept live chats
# and answer as the real you. Pick something friends won't guess.
ADMIN_KEY=changeme
